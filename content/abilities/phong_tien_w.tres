[gd_resource type="Resource" script_class="AbilityDef" format=3]

[ext_resource type="Resource" path="res://content/effects/phong_tien_poison_slow.tres" id="1_x"]
[ext_resource type="Resource" path="res://content/effects/silence.tres" id="2_x"]
[ext_resource type="Script" path="res://sim/actions/action_def.gd" id="3_x"]
[ext_resource type="Script" path="res://sim/defs/value_change_def.gd" id="4_x"]
[ext_resource type="Script" path="res://sim/actions/damage_action.gd" id="5_x"]
[ext_resource type="Script" path="res://sim/actions/apply_effect_action.gd" id="6_x"]
[ext_resource type="Script" path="res://sim/actions/area_action.gd" id="7_x"]
[ext_resource type="Script" path="res://sim/defs/talent_def.gd" id="8_x"]
[ext_resource type="Script" path="res://sim/defs/ability_def.gd" id="9_x"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("5_x")
damage_type = 1
amount = "damage"

[sub_resource type="Resource" id="S2"]
script = ExtResource("6_x")
effect = ExtResource("1_x")
duration = "duration"

[sub_resource type="Resource" id="S3"]
script = ExtResource("6_x")
effect = ExtResource("2_x")
duration = "duration"

[sub_resource type="Resource" id="S4"]
script = ExtResource("7_x")
radius = "radius"
actions = Array[ExtResource("3_x")]([SubResource("S1"), SubResource("S2"), SubResource("S3")])

[sub_resource type="Resource" id="S5"]
script = ExtResource("4_x")
value_name = &"radius"
amount = 100.0

[sub_resource type="Resource" id="S6"]
script = ExtResource("8_x")
id = &"phong_tien_w_ii"
display_name = "Bão Độc"
description = "Bán kính +100"
value_changes = Array[ExtResource("4_x")]([SubResource("S5")])

[resource]
script = ExtResource("9_x")
description = "Thổi gió độc vào một vùng bán kính 300: sát thương phép, làm chậm 25% và câm lặng."
slot = 2
targeting = 3
values = Dictionary[StringName, PackedFloat32Array]({
&"cast_range": PackedFloat32Array(800, 800, 800, 800, 800),
&"cooldown": PackedFloat32Array(18, 17, 16, 15, 14),
&"damage": PackedFloat32Array(60, 100, 140, 180, 220),
&"duration": PackedFloat32Array(1, 1.5, 2, 2.5, 3),
&"mana": PackedFloat32Array(90, 95, 100, 105, 110),
&"radius": PackedFloat32Array(300, 300, 300, 300, 300),
&"slow": PackedFloat32Array(0.25, 0.25, 0.25, 0.25, 0.25)
})
cast_time = "0.3"
on_cast = Array[ExtResource("3_x")]([SubResource("S4")])
talent = SubResource("S6")
bot_usages = Array[int]([0, 6])
bot_conditions = Array[StringName]([&"enemy_hero_in_range", &"two_enemies_in_area"])
id = &"phong_tien_w"
display_name = "Gió Độc"
art_id = &"phong_tien_w"
