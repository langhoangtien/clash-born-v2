[gd_resource type="Resource" script_class="AbilityDef" format=3]

[ext_resource type="Resource" path="res://content/effects/stun.tres" id="1_x"]
[ext_resource type="Script" path="res://sim/actions/action_def.gd" id="2_x"]
[ext_resource type="Script" path="res://sim/defs/value_change_def.gd" id="3_x"]
[ext_resource type="Script" path="res://sim/actions/damage_action.gd" id="4_x"]
[ext_resource type="Script" path="res://sim/actions/apply_effect_action.gd" id="5_x"]
[ext_resource type="Script" path="res://sim/actions/area_action.gd" id="6_x"]
[ext_resource type="Script" path="res://sim/defs/talent_def.gd" id="7_x"]
[ext_resource type="Script" path="res://sim/defs/ability_def.gd" id="8_x"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("4_x")
damage_type = 1
amount = "damage"

[sub_resource type="Resource" id="S2"]
script = ExtResource("5_x")
effect = ExtResource("1_x")
duration = "stun_duration"

[sub_resource type="Resource" id="S3"]
script = ExtResource("6_x")
radius = "radius"
target = 0
actions = Array[ExtResource("2_x")]([SubResource("S1"), SubResource("S2")])

[sub_resource type="Resource" id="S4"]
script = ExtResource("3_x")
value_name = &"radius"
amount = 100.0

[sub_resource type="Resource" id="S5"]
script = ExtResource("7_x")
id = &"thach_giap_q_ii"
display_name = "Động Đá"
description = "Bán kính +100"
value_changes = Array[ExtResource("3_x")]([SubResource("S4")])

[resource]
script = ExtResource("8_x")
description = "Dậm đất: kẻ địch trong bán kính 300 nhận sát thương phép và bị choáng."
slot = 1
targeting = 1
values = Dictionary[StringName, PackedFloat32Array]({
&"cooldown": PackedFloat32Array(13, 12, 11, 10, 9),
&"damage": PackedFloat32Array(60, 100, 140, 180, 220),
&"mana": PackedFloat32Array(90, 95, 100, 105, 110),
&"radius": PackedFloat32Array(300, 300, 300, 300, 300),
&"stun_duration": PackedFloat32Array(1, 1.2, 1.4, 1.6, 1.8)
})
cast_time = "0.4"
on_cast = Array[ExtResource("2_x")]([SubResource("S3")])
talent = SubResource("S5")
bot_usages = Array[int]([0])
bot_conditions = Array[StringName]([&"enemy_hero_in_radius"])
id = &"thach_giap_q"
display_name = "Dậm Đá"
art_id = &"thach_giap_q"
