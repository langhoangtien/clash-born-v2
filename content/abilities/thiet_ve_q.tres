[resource]
script = ExtResource("7_x")
description = "Gầm lên: kẻ địch trong bán kính 300 bị khiêu khích — buộc đánh Thiết Vệ, không dùng chiêu / đồ (ST-20). Xuyên miễn phép; chỉ thanh tẩy mạnh gỡ."
slot = 1
targeting = 1
pierces_magic_immunity = true
