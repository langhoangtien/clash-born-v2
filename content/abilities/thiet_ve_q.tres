&"cooldown": PackedFloat32Array(16, 15, 14, 13, 12),
&"duration": PackedFloat32Array(1.6, 1.8, 2, 2.2, 2.4),
&"mana": PackedFloat32Array(80, 85, 90, 95, 100),
&"radius": PackedFloat32Array(300, 300, 300, 300, 300)
})
