bot_usages = Array[int]([0, 6])
bot_conditions = Array[StringName]([&"enemy_hero_in_radius", &"two_enemies_in_area"])
id = &"thiet_ve_q"
display_name = "Khiêu Khích"
art_id = &"thiet_ve_q"
