[gd_resource type="Resource" script_class="AbilityDef" format=3]

[ext_resource type="Script" path="res://sim/actions/action_def.gd" id="1_act"]
[ext_resource type="Resource" path="res://content/effects/huyet_blood_return.tres" id="2_eff"]
[ext_resource type="Script" path="res://sim/actions/apply_effect_action.gd" id="3_app"]
[ext_resource type="Script" path="res://sim/defs/ability_def.gd" id="4_abl"]
[ext_resource type="Script" path="res://sim/defs/talent_def.gd" id="5_tal"]
[ext_resource type="Script" path="res://sim/defs/value_change_def.gd" id="6_vc"]

[sub_resource type="Resource" id="A0"]
script = ExtResource("3_app")
effect = ExtResource("2_eff")
target = 0

[sub_resource type="Resource" id="VC0"]
script = ExtResource("6_vc")
value_name = &"fraction"
amount = 0.15

[sub_resource type="Resource" id="TAL"]
script = ExtResource("5_tal")
id = &"huyet_cu_nhan_w_ii"
display_name = "Huyết Gai"
description = "Phản thêm 15% Sức mạnh mỗi đòn"
value_changes = Array[ExtResource("6_vc")]([SubResource("VC0")])

[resource]
script = ExtResource("4_abl")
description = "Bị động: mỗi đòn đánh trúng Huyết Cự Nhân (không phải công trình) phản lại kẻ đánh sát thương vật lý bằng 10 / 14 / 17 / 21 / 25% Sức mạnh."
slot = 2
targeting = 0
values = Dictionary[StringName, PackedFloat32Array]({
&"fraction": PackedFloat32Array(0.1, 0.14, 0.17, 0.21, 0.25)
})
on_learn = Array[ExtResource("1_act")]([SubResource("A0")])
talent = SubResource("TAL")
id = &"huyet_cu_nhan_w"
display_name = "Phản Huyết"
art_id = &"huyet_cu_nhan_w"
