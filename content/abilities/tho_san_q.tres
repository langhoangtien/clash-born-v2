[resource]
script = ExtResource("7_x")
description = "Một kẻ địch: sát thương vật lý và làm chậm 30% trong 2 s."
slot = 1
targeting = 2
target_team = 0
values = Dictionary[StringName, PackedFloat32Array]({
&"cast_range": PackedFloat32Array(600, 600, 600, 600, 600),
&"cooldown": PackedFloat32Array(10, 9, 8, 7, 6),
&"damage": PackedFloat32Array(80, 120, 160, 200, 240),
&"mana": PackedFloat32Array(70, 75, 80, 85, 90),
&"slow": PackedFloat32Array(0.3, 0.3, 0.3, 0.3, 0.3),
&"slow_duration": PackedFloat32Array(2, 2, 2, 2, 2)
})
on_cast = Array[ExtResource("2_x")]([SubResource("S1"), SubResource("S2")])
talent = SubResource("S4")
bot_usages = Array[int]([1, 2])
bot_conditions = Array[StringName]([&"enemy_hero_in_range", &"enemy_hp_below_damage"])
id = &"tho_san_q"
display_name = "Truy Kích"
art_id = &"tho_san_q"
