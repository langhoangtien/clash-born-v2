[resource]
script = ExtResource("6_jvac1")
description = "Mưa sao băng bán kính 400 sau 1 s: sát thương phép lớn và câm lặng."
slot = 3
targeting = 3
values = Dictionary[StringName, PackedFloat32Array]({
&"cast_range": PackedFloat32Array(900, 900, 900),
&"cooldown": PackedFloat32Array(80, 70, 60),
&"damage": PackedFloat32Array(250, 375, 500),
&"delay": PackedFloat32Array(1, 1, 1),
&"mana": PackedFloat32Array(150, 200, 250),
&"radius": PackedFloat32Array(400, 400, 400),
&"silence_duration": PackedFloat32Array(2, 2.5, 3)
})
on_cast = Array[ExtResource("1_jarcr")]([SubResource("Resource_lqmds")])
talent = SubResource("Resource_1a6df")
bot_usages = Array[int]([2, 6])
bot_conditions = Array[StringName]([&"enemy_hp_below_damage", &"two_enemies_in_area"])
id = &"myra_r"
display_name = "Mưa Sao Băng"
art_id = &"myra_r"
