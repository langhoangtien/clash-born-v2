target_team = 2
values = Dictionary[StringName, PackedFloat32Array]({
&"cooldown": PackedFloat32Array(90, 80, 70),
&"duration": PackedFloat32Array(4, 5, 6),
&"heal_fraction": PackedFloat32Array(0.2, 0.3, 0.4),
&"mana": PackedFloat32Array(150, 175, 200),
&"move_bonus": PackedFloat32Array(0.2, 0.25, 0.3)
})
on_cast = Array[ExtResource("1_8r84e")]([SubResource("Resource_1noc4")])
