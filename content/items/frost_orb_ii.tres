[resource]
script = ExtResource("7_itm")
category = 2
description = "+35 mọi thuộc tính. Bị động: đòn đánh gây Tê Cóng 3 s — giảm 10% sát thương vật lý và 30% hồi máu của mục tiêu. Chủ động (hồi 25 s): 5 s, đòn đánh giảm 75% hồi máu."
cost = 5300
components = Array[StringName]([&"frost_orb", &"frost_orb"])
modifiers = Array[ExtResource("6_mod")]([SubResource("M0"), SubResource("M1"), SubResource("M2")])
ability = SubResource("AB")
