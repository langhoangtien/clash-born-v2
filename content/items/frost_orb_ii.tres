values = Dictionary[StringName, PackedFloat32Array]({
&"burst_duration": PackedFloat32Array(5),
&"burst_heal_cut": PackedFloat32Array(0.75),
&"cooldown": PackedFloat32Array(25),
&"frostbite_damage_cut": PackedFloat32Array(0.1),
&"frostbite_duration": PackedFloat32Array(3),
&"frostbite_heal_cut": PackedFloat32Array(0.3)
})
