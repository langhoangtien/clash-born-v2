[gd_resource type="Resource" script_class="ItemDef" format=3]

[ext_resource type="Script" path="res://sim/actions/action_def.gd" id="1_act"]
[ext_resource type="Resource" path="res://content/effects/silence.tres" id="2_sil"]
[ext_resource type="Script" path="res://sim/actions/apply_effect_action.gd" id="3_app"]
[ext_resource type="Script" path="res://sim/defs/ability_def.gd" id="4_abl"]
[ext_resource type="Script" path="res://sim/defs/modifier_def.gd" id="5_mod"]
[ext_resource type="Script" path="res://sim/defs/item_def.gd" id="6_item"]

[sub_resource type="Resource" id="A0"]
script = ExtResource("3_app")
effect = ExtResource("2_sil")
duration = "duration"

[sub_resource type="Resource" id="AB"]
script = ExtResource("4_abl")
slot = 4
targeting = 2
hits_creeps = false
hits_neutrals = false
values = Dictionary[StringName, PackedFloat32Array]({
&"cast_range": PackedFloat32Array(900),
&"cooldown": PackedFloat32Array(18),
&"duration": PackedFloat32Array(4),
&"mana": PackedFloat32Array(100)
})
on_cast = Array[ExtResource("1_act")]([SubResource("A0")])
bot_usages = Array[int]([0])
bot_conditions = Array[StringName]([&"enemy_hero_in_range"])
id = &"orchid_active"
art_id = &"orchid"

[sub_resource type="Resource" id="M0"]
script = ExtResource("5_mod")
stat = &"intelligence"
value = "18"

[sub_resource type="Resource" id="M1"]
script = ExtResource("5_mod")
stat = &"attack_speed"
value = "0.25"

[sub_resource type="Resource" id="M2"]
script = ExtResource("5_mod")
stat = &"mana_regen"
value = "2.5"

[resource]
script = ExtResource("6_item")
category = 1
description = "Chủ động (hồi 18 s, 100 mana, tầm 900): câm lặng một tướng địch 4 giây — không dùng được chiêu."
cost = 3000
components = Array[StringName]([&"staff_wizardry", &"gloves_haste", &"void_stone"])
modifiers = Array[ExtResource("5_mod")]([SubResource("M0"), SubResource("M1"), SubResource("M2")])
ability = SubResource("AB")
id = &"orchid"
display_name = "Hoa Câm Lặng"
art_id = &"orchid"
