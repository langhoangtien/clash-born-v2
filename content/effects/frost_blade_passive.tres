[gd_resource type="Resource" script_class="EffectDef" format=3]

[ext_resource type="Script" path="res://sim/actions/action_def.gd" id="1_act"]
[ext_resource type="Script" path="res://sim/defs/effect_def.gd" id="2_eff"]
[ext_resource type="Script" path="res://sim/defs/trigger_def.gd" id="3_trg"]
[ext_resource type="Script" path="res://sim/actions/apply_effect_action.gd" id="4_app"]
[ext_resource type="Resource" path="res://content/effects/frost_blade_slow_melee.tres" id="5_m"]
[ext_resource type="Resource" path="res://content/effects/frost_blade_slow_ranged.tres" id="6_r"]

[sub_resource type="Resource" id="A0"]
script = ExtResource("4_app")
effect = ExtResource("5_m")
duration = "duration"
target = 3

[sub_resource type="Resource" id="A1"]
script = ExtResource("4_app")
effect = ExtResource("6_r")
