condition = &"target_is_ranged"
actions = Array[ExtResource("1_act")]([SubResource("A1")])

[resource]
script = ExtResource("2_eff")
duration = "0"
tags = Array[StringName]([&"passive"])
dispel = 2
triggers = Array[ExtResource("3_trg")]([SubResource("T0"), SubResource("T1")])
