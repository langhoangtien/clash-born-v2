# Clashborn — /etc/caddy/Caddyfile (Caddy tự cấp HTTPS cho domain).
clashborn.quest, www.clashborn.quest {
	encode gzip
	root * /srv/clashborn/www

	# Cổng nhận bản build → máy chủ Python chỉ nghe 127.0.0.1:8787 (kiểm mã bí mật).
	handle /api/* {
		request_body {
			max_size 400MB
		}
		reverse_proxy 127.0.0.1:8787
	}

	# version.json luôn mới (app hỏi mỗi lần mở); APK theo số bản thì cache lâu.
	header /version.json Cache-Control "no-cache"
	header /download/* Cache-Control "no-cache"
	header /releases/* Cache-Control "public, max-age=31536000, immutable"
	@apk path *.apk
	header @apk Content-Type "application/vnd.android.package-archive"

	handle {
		file_server
	}
}
